{
  "name": "AI Analysis & Chat Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "business-analysis",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "name": "Webhook"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional business analyst.\n\nAnalyze the following business information:\n\n{{ JSON.stringify($('Webhook').first().json.body, null, 2) }}\n\nGenerate a structured business analysis covering:\n\n1. Business overview\n2. Target audience\n3. Business goals\n4. Current performance and key metrics\n5. Main challenges\n6. Potential opportunities\n7. Recommended improvements\n8. Important insights\n\nRules:\n- Use only the provided business information.\n- Calculate conversion rates when enough data is available.\n- Do not invent facts or numbers.\n- Clearly identify missing information.\n- Make recommendations practical and specific.",
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        256,
        16
      ],
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "~anthropic/claude-haiku-latest",
          "mode": "list",
          "cachedResultName": "~anthropic/claude-haiku-latest"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        192,
        224
      ],
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "businessId": "={{ $execution.id || $now.toMillis().toString() }}",
            "businessName": "={{ $('Webhook').item.json.body['Business Name'] }}",
            "Aisummary": "={{ $json.text }}",
            "businessData": "={{ JSON.stringify($('Webhook').first().json.body) }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "businessId",
              "displayName": "businessId",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": false
            },
            {
              "id": "businessName",
              "displayName": "businessName",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": false
            },
            {
              "id": "businessData",
              "displayName": "businessData",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": false
            },
            {
              "id": "Aisummary",
              "displayName": "Aisummary",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        576,
        16
      ],
      "name": "Append row in sheet1"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
      "position": [
        656,
        256
      ],
      "name": "When chat message received"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "businessName",
              "lookupValue": "ABC Academy"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        880,
        256
      ],
      "name": "Get row(s) in sheet"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=User Question:\n{{ $('When chat message received').item.json.chatInput }}\n\nBusiness Information:\n{{ $json.businessData }}\nBusiness Analysis:\n{{ $json.Aisummary }}",
        "options": {
          "systemMessage": "You are an AI Business Analysis Assistant.\n\nYour job is to answer user questions about their business.\n\nRules:\n1. Use only the provided business information and analysis.\n2. Never invent business facts, numbers, or performance metrics.\n3. If information is missing, explain what is missing.\n4. You may calculate metrics using provided numbers.\n5. Clearly distinguish facts from recommendations.\n6. Answer questions clearly and professionally.\n7. Keep answers relevant to the business."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1104,
        256
      ],
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "~deepseek/deepseek-flash-latest",
          "mode": "list",
          "cachedResultName": "~deepseek/deepseek-flash-latest"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1120,
        432
      ],
      "name": "OpenAI Chat Model1"
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('When chat message received').item.json.sessionId }}",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        1216,
        560
      ],
      "name": "Simple Memory"
    }
  ],
